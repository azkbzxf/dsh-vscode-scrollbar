{
  "name": "dsh-vscode-scrollbar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: restyles the conversation scrollbar to match the Visual Studio Code editor scrollbar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azkbzxf/dsh-vscode-scrollbar.git"
  },
  "homepage": "https://github.com/azkbzxf/dsh-vscode-scrollbar#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "scrollbar",
    "vscode"
  ],
  "scripts": {
    "test": "node test/harness.mjs client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
